# Copy to .env and fill in. Never commit .env. `npm run demo` needs none of this.

# --- PayPal (sandbox app credentials from developer.paypal.com) ---
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Model: "stub" (deterministic, no network), "openai" (any OpenAI-compatible
#     chat-completions endpoint) or "anthropic" (Messages API) ---
MODEL_PROVIDER=stub
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# --- Local server ---
PORT=4310
JOURNAL_PATH=data/journal.jsonl
